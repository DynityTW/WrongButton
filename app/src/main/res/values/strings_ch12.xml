    <string name="l174_empty">（還沒說）</string>
    <string name="l175_title">翻譯員</string>
    <string name="l175_hint_1">旁邊有一個翻譯員。</string>
    <string name="l175_hint_2">翻譯員的翻譯不一定對。</string>
    <string name="l175_hint_3">不要看翻譯員，自己查字典翻譯，再看我的臉。</string>
    <string name="l175_translator">翻譯員：「%1$s」</string>
    <string name="l176_title">或</string>
    <string name="l176_hint_1">新的字：＋。</string>
    <string name="l176_hint_2">例句告訴妳 ＋ 的意思。</string>
    <string name="l176_hint_3">＋ 是「或」。「⊘ ◀ ＋ ▶」是「不是左邊，也不是右邊」。</string>
    <string name="l177_title">長句</string>
    <string name="l177_hint_1">三句話，三張臉。</string>
    <string name="l177_hint_2">每句都可能有 ＋。</string>
    <string name="l177_hint_3">一句一句翻譯並判斷真假，合起來只剩一顆。</string>
    <string name="l178_title">沒有字典</string>
    <string name="l178_hint_1">畫面上沒有字典。</string>
    <string name="l178_hint_2">妳已經學會了（紀錄裡也還有）。</string>
    <string name="l178_hint_3">● 是、⊘ 不是、＋ 或；☽ ☀ ★ ☁ 是 1 到 4。</string>

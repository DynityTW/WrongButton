<?xml version="1.0" encoding="utf-8"?>
<!-- 台灣繁體中文。台詞前綴 [mood|tell] 標記表情，見 core/dialogue/LineMarkup。 -->
<resources>
    <string name="l06_title">顧問</string>
    <string name="l06_hint_1">答案不在按鈕上，在它臉上。</string>
    <string name="l06_hint_2">比較一下它每次說話時眼睛看哪裡。</string>
    <string name="l06_hint_3">它看著妳就是實話，看旁邊就是謊話。謊話要反著聽。一共四題。</string>
    <string name="l06_is_left">是左邊。</string>
    <string name="l06_is_right">是右邊。</string>
    <string name="l06_is_middle">是中間。</string>
    <string name="l06_not_left">不是左邊。</string>
    <string name="l06_not_middle">不是中間。</string>
    <string name="l06_not_right">不是右邊。</string>
    <string name="l06_advisor_tap">我今天是顧問，不是按鈕。</string>
    <string name="l06_next">下一題。</string>
    <string name="l06_advisor_label">顧問</string>
    <string name="l06_round">第 %1$d／%2$d 回合</string>
    <string name="l06_candidate">按鈕</string>
    <string name="l06_candidate_cd">%1$s的按鈕</string>
    <string name="l06_pos_left">左邊</string>
    <string name="l06_pos_middle">中間</string>
    <string name="l06_pos_right">右邊</string>
    <string name="l22_unmask">……好多了。</string>
    <string name="l21_title">開或關</string>
    <string name="l21_hint_1">每個開關旁邊都有一個小圖示。</string>
    <string name="l21_hint_2">它說要開的時候，眼睛看哪裡？</string>
    <string name="l21_hint_3">點 ⓘ 聽它說；看著妳就照做，看旁邊就反著做，最後按套用。</string>
    <string name="l21_row_glow">讓我發光</string>
    <string name="l21_row_quiet">讓我安靜</string>
    <string name="l21_row_rest">讓我休息</string>
    <string name="l21_info_cd">「%1$s」的說明</string>
    <string name="l21_says_on">這個要開。</string>
    <string name="l21_says_off">這個要關。</string>
    <string name="l21_apply">套用</string>
    <string name="l21_wrong">我要的不是這樣。……好吧，我剛剛沒說清楚。</string>
    <string name="l21_poke">問我開關的事，點 ⓘ。</string>
    <string name="l22_title">太亮了</string>
    <string name="l22_hint_1">它為什麼戴墨鏡？</string>
    <string name="l22_hint_2">畫面上有個東西可以讓這裡不那麼亮。</string>
    <string name="l22_hint_3">把亮度拉低，它會摘下墨鏡。或者只看嘴角：一邊翹起就是謊話。</string>
    <string name="l22_special_line">妳只看我的嘴就知道了？</string>
    <string name="l23_title">重要公告</string>
    <string name="l23_hint_1">它的嘴被擋住了，眼睛還在。</string>
    <string name="l23_hint_2">橫幅通常可以滑掉。</string>
    <string name="l23_hint_3">看它的眼睛：看旁邊就是謊話。也可以把橫幅滑掉。</string>
    <string name="l24_title">頭像</string>
    <string name="l24_hint_1">它的臉變得好小。</string>
    <string name="l24_hint_2">聊天 App 裡，想看清楚對方的頭像會怎麼做？</string>
    <string name="l24_hint_3">點訊息旁的小頭像放大，看它說那句話時的表情。</string>
    <string name="l25_title">兩句話</string>
    <string name="l25_hint_1">一句話不夠，就看兩句。</string>
    <string name="l25_hint_2">謊話反過來也是一條線索。</string>
    <string name="l25_hint_3">每一句都先依頭像判斷真假，再把剩下的可能刪掉。</string>
    <string name="l26_title">已編輯</string>
    <string name="l26_hint_1">這則訊息被改過。</string>
    <string name="l26_hint_2">點訊息可以看到編輯紀錄。</string>
    <string name="l26_hint_3">看兩個版本各自的頭像，把真話挑出來，謊話反過來。</string>
    <string name="l26_edited">（已編輯）</string>
    <string name="l26_history_button">查看編輯紀錄</string>
    <string name="l26_history_title">編輯紀錄</string>
    <string name="l26_original">原本</string>
    <string name="l26_after">改成</string>
    <string name="l27_title">引用</string>
    <string name="l27_hint_1">被引用的那句話沒有臉。</string>
    <string name="l27_hint_2">有臉的那一句，在評論沒臉的那一句。</string>
    <string name="l27_hint_3">先看回覆的頭像判斷它是真是假，再決定被引用的那句能不能信。</string>
    <string name="l27_reply_lie">我上一句是謊話。</string>
    <string name="l27_reply_true">我上一句是實話。</string>
    <string name="l28_title">同事</string>
    <string name="l28_hint_1">同事不會說謊，但它只照字面回答。</string>
    <string name="l28_hint_2">兩個問題，四顆按鈕。怎麼問才夠？</string>
    <string name="l28_hint_3">問「在左半邊嗎」和「在上排嗎」，別理 The Button 的建議。</string>
    <string name="l28_colleague">同事</string>
    <string name="l28_colleague_poke">它不會說話，除非妳問它。</string>
    <string name="l28_button_tip">問它「哪一顆是正確的」就好啦。</string>
    <string name="l28_left_count">還可以問 %1$d 題</string>
    <string name="l28_q_left">在左半邊嗎？</string>
    <string name="l28_q_top">在上排嗎？</string>
    <string name="l28_q_which">哪一顆是正確的？</string>
    <string name="l28_q_sure">你確定嗎？</string>
    <string name="l28_yes">是。</string>
    <string name="l28_no">不是。</string>
    <string name="l28_literal_which">正確的那一顆。</string>
    <string name="l28_colleague_says">同事：%1$s</string>
    <string name="l28_pos_tl">左上</string>
    <string name="l28_pos_tr">右上</string>
    <string name="l28_pos_bl">左下</string>
    <string name="l28_pos_br">右下</string>
    <string name="l29_title">預覽</string>
    <string name="l29_hint_1">這則訊息只顯示了一部分。</string>
    <string name="l29_hint_2">預覽沒有臉。</string>
    <string name="l29_hint_3">點預覽卡打開完整訊息，看頭像再決定。</string>
    <string name="l30_title">限時動態</string>
    <string name="l30_hint_1">它說得很快，但會重播。</string>
    <string name="l30_hint_2">看動態的時候，按住畫面會怎樣？</string>
    <string name="l30_hint_3">按住暫停、點左邊回上一段，三句都依表情判斷後再選。</string>
    <string name="l30_prev">上一段</string>
    <string name="l30_next">下一段</string>
    <string name="l30_segment">%1$d／%2$d</string>
    <string name="l31_title">貼圖</string>
    <string name="l31_hint_1">貼圖上也是它的臉。</string>
    <string name="l31_hint_2">比讚不一定是「是」。</string>
    <string name="l31_hint_3">看貼圖的眼睛：看旁邊就把意思反過來。</string>
    <string name="l31_left">還可以問 %1$d 題</string>
    <string name="l31_ask">是%1$s嗎？</string>
    <string name="l31_thumbs_up">（比讚的貼圖）</string>
    <string name="l31_thumbs_down">（搖頭的貼圖）</string>
    <string name="l32_title">請稍候</string>
    <string name="l32_hint_1">這條進度條有在前進嗎？</string>
    <string name="l32_hint_2">它叫妳別按取消的時候，眼睛看哪裡？</string>
    <string name="l32_hint_3">它在說謊。按取消。</string>
    <string name="l32_dont_cancel">再等一下就好了。不要按取消。</string>
    <string name="l32_not_ready">還沒好啦，再等一下。</string>
    <string name="l32_waiting">請稍候…</string>
    <string name="l32_after_cancel">……妳現在連這個都看得出來了。</string>
    <string name="l33_title">它說妳</string>
    <string name="l33_hint_1">它說的不全是真的。</string>
    <string name="l33_hint_2">哪一句是假的，看臉；正確答案在哪，妳去過。</string>
    <string name="l33_hint_3">說謊臉的那句按更正，去「紀錄」查嘗試次數填回來。</string>
    <string name="l33_statement">第 %1$d 關，妳試了 %2$d 次。</string>
    <string name="l33_ok">沒錯</string>
    <string name="l33_fix">更正</string>
    <string name="l33_done">✓ 已確認</string>
    <string name="l33_wrong">不對喔。我們重來一次。</string>
    <string name="l34_title">三個我</string>
    <string name="l34_hint_1">三個都是它，各有各的遮掩。</string>
    <string name="l34_hint_2">這一章學過的每一招，這裡都用得上。</string>
    <string name="l34_hint_3">調低亮度、滑掉橫幅、放大頭像，三句各自判斷真假，再合起來。</string>
    <string name="l34_zoom">放大</string>
</resources>

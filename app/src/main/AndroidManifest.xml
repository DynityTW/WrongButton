<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        本遊戲不向使用者請求任何「危險」權限（不會跳出權限對話框）。
        合併後的 manifest 只能有白名單裡的權限（Google Play 結帳、AdMob 需要的網路與廣告 ID），
        白名單見 app/build.gradle.kts 的 allowedPermissions。
    -->

    <!-- AdMob 帶進來的 Privacy Sandbox 權限（廣告歸因、興趣主題）：我們不使用，拿掉。 -->
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_TOPICS" tools:node="remove" />

    <application
        android:name=".app.WrongButtonApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WrongButton"
        tools:targetApi="37">
        <!-- singleTop：從桌面捷徑或小工具回到遊戲時，沿用正在跑的畫面（onNewIntent）。 -->
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- AdMob 應用程式 ID（debug 是測試 ID；正式 ID 在 app/build.gradle.kts 設定）。 -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${admobAppId}" />

        <!-- 桌面小工具（第 9 章）。 -->
        <receiver
            android:name=".app.ButtonWidget"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>
    </application>
</manifest>
